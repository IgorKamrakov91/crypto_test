# Optional local notes for Ethereum RPC providers.
# The current backend defaults to https://eth.llamarpc.com and also accepts
# a per-request rpc_url query parameter.
#
# Keep provider-specific private URLs or API keys in your local .env file only.
ETH_RPC_URL=https://eth.llamarpc.com

# Local development URLs
BACKEND_URL=http://localhost:4567
FRONTEND_URL=http://localhost:5173

# Comma-separated browser origins allowed to call the Sinatra API.
CORS_ORIGINS=http://localhost:5173
